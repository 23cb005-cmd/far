# ---------------------------------------------------------------------------
# FarmFair server configuration
# Copy to `server/.env` and adjust. The server refuses to start if any value
# below is missing or invalid.
# ---------------------------------------------------------------------------

# --- core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/farmfair?directConnection=true
CLIENT_URL=http://localhost:5173

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters each, and must differ from one another.
JWT_ACCESS_SECRET=change-me-dev-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-at-least-32-chars-long
# Leave blank for localhost. In production set it to the parent domain shared by
# the client and API (e.g. .farmfair.in) so cookies are sent to both.
COOKIE_DOMAIN=

# --- logging ---
# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=debug

# --- rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_OTP_MAX=3
# Enable only when running behind a proxy you control (Render, Nginx).
TRUST_PROXY=false

# --- OTP ---
# console = print the code to the server log (development)
OTP_PROVIDER=console

# ===========================================================================
# Optional - reserved for later phases. Safe to leave unset.
# ===========================================================================

# Phase 2 - mandi prices (without a key, realistic sample prices are generated)
DATA_GOV_API_KEY=
DATA_GOV_STATE=Tamil Nadu

# Phase 3 - uploads
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
LISTING_EXPIRY_DAYS=7

# Phase 4 - payments
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMISSION_PERCENT=1

# Phase 5 - notifications and scheduled jobs
NOTIFY_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TELEGRAM_BOT_TOKEN=
JOBS_ENABLED=false
PRICE_ALERT_THRESHOLD=10

# Phase 6 - WhatsApp bot (public URL Twilio posts webhooks to)
PUBLIC_BASE_URL=

# Phase 8 - error tracking (disabled when empty)
SENTRY_DSN=
