{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      // Typecheck against the shared sources so `npm run typecheck` works on a
      // clean checkout, before `shared` has been built.
      "@farmfair/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
